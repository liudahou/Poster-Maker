AI_IMAGE_PROVIDER=openai

# GPT Image / OpenAI-compatible provider
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_API_BASE=https://www.zeoapi.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=512x768
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_OUTPUT_FORMAT=png

# Alibaba Cloud Model Studio / DashScope provider
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0
DASHSCOPE_IMAGE_SIZE=512*768
