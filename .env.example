AI_IMAGE_PROVIDER=openai
AI_IMAGE_API_KEY=
AI_IMAGE_API_BASE=https://api.openai.com/v1
AI_IMAGE_MODEL=gpt-image-2
AI_IMAGE_SIZE=1024x1536
AI_IMAGE_QUALITY=medium
AI_IMAGE_OUTPUT_FORMAT=png

# Optional: enable this if your computer needs a local HTTP proxy/VPN to reach api.openai.com.
# Common local proxy ports are 7890, 10809, 10808, or 20171. Check your proxy app settings.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
